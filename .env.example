# Copy to .env (gitignored) and fill in. Add every new env var here, with a comment.

# ---- Specflow team (scripts/orchestrate.mjs team). All optional. ----
# A second GitHub account for one CLI's windows, so reviews are real approvals across accounts.
# Sign it in once with: GH_CONFIG_DIR=~/.config/gh-reviewer gh auth login
# SPECFLOW_GH_CONFIG_COPILOT=~/.config/gh-reviewer
# SPECFLOW_GH_CONFIG_CLAUDE=
# The model each CLI's agents start with (passed as --model).
# SPECFLOW_MODEL_CLAUDE=
# SPECFLOW_MODEL_COPILOT=
